# AgentGate Production Deployment Environment Variables
# Copy to .env or run scripts/init-secrets.ps1 to generate automatically

# Keycloak Configuration
KC_HOSTNAME=https://keycloak:8443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
ADMIN_INITIAL_PASSWORD=change-me-admin-initial-password

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_DB=agentgate_prod_db
POSTGRES_PASSWORD=change-me-postgres-password
AGENTGATE_MIGRATOR_PASSWORD=change-me-migrator-password
AGENTGATE_APP_PASSWORD=change-me-app-password
KEYCLOAK_DB_PASSWORD=change-me-keycloak-password

# Database Connection URLs
AGENTGATE_MIGRATOR_DATABASE_URL=postgres://agentgate_migrator:change-me-migrator-password@postgres:5432/agentgate_prod_db?sslmode=disable
AGENTGATE_DATABASE_URL=postgres://agentgate_app:change-me-app-password@postgres:5432/agentgate_prod_db?sslmode=disable

# Audit Salt
AGENTGATE_AUDIT_SALT=change-me-audit-salt-random-hex

# Keycloak Client Secrets
AGENT_READER_CLIENT_SECRET=change-me-reader-secret
AGENT_ADMIN_CLIENT_SECRET=change-me-admin-secret
OPS_CLI_CLIENT_SECRET=change-me-ops-cli-secret

# AgentGate Core Settings
AGENTGATE_ENV=production
AGENTGATE_DB_ALLOW_INSECURE=true
AGENTGATE_OIDC_ISSUER_URL=https://keycloak:8443/realms/agentgate
AGENTGATE_OIDC_AUDIENCE=agentgate-admin-api
AGENTGATE_OIDC_ADMIN_ROLE=agentgate-admin
AGENTGATE_CREDENTIAL_AUDIENCES=default=support-desk,mcp-probe=support-desk
AGENTGATE_REQUIRE_DOWNSTREAM_CREDENTIAL=true

# Admin UI Runtime Settings
AGENTGATE_UI_API_URL=https://localhost:9443
AGENTGATE_UI_OIDC_AUTHORITY=https://localhost:8443/realms/agentgate
AGENTGATE_UI_OIDC_CLIENT_ID=agentgate-admin-ui
