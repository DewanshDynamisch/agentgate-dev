FROM node:22-alpine AS builder

WORKDIR /frontend/app

COPY frontend/app/package.json frontend/app/package-lock.json ./
RUN npm ci

COPY frontend/src /frontend/src
COPY frontend/app /frontend/app
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

USER root

COPY --from=builder /frontend/app/dist /usr/share/nginx/html
COPY deploy/docker/config.js.template /usr/share/nginx/html/config.js.template
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/docker/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh && \
    touch /usr/share/nginx/html/config.js && \
    chown -R 101:101 /usr/share/nginx/html /etc/nginx/conf.d /etc/nginx/templates /docker-entrypoint.sh

USER 101

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
